# 数据库连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=grid_app
DB_PASSWORD=请改成数据库密码
DB_NAME=grid_trading

# 行情模式：mock（模拟）/ real（真实行情）
MARKET_DATA_MODE=real

# JWT 签名密钥（生产环境必须修改为随机值，至少 32 个字符）
JWT_SECRET=

# 推送 Webhook（可选，不配置则对应渠道不推送）
DINGTALK_WEBHOOK=
WECHAT_WEBHOOK=

# 后端监听地址与端口（与 uvicorn 启动参数保持一致）
APP_HOST=127.0.0.1
APP_PORT=8000
